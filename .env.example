# Local Compose example only. Copy to .env without replacing an existing file.
# Generate unique secrets before starting; empty values deliberately prevent startup.
ENVIRONMENT=development
POSTGRES_USER=biletflow_test
POSTGRES_DB=biletflow_test
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
DB_PORT=55432
BACKEND_PORT=8000
API_BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
