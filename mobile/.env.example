# Use the team's reachable backend URL. No /docs or trailing /auth.
# For local development, use your computer's LAN IP (phone on the same Wi-Fi).
# The address below is an example only. Replace it with the actual server LAN address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Website used by the attendee, organizer and admin sections. Use HTTPS for a distribution build.
# On the development phone, use the same computer's actual LAN address and the Vite port.
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173
