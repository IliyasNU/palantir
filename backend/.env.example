ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://palantir:palantir@localhost:5432/palantir
# Local development only. For production set ENVIRONMENT=production and generate a new
# random JWT_SECRET_KEY (at least 32 bytes for HS256, 48 for HS384, 64 for HS512).
# The public development key below is rejected in production.
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
